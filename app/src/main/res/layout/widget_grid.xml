<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget (widget/Widgets.kt): up to 4 x 4 cells; the rows and cells a widget doesn't use are hidden.
     Each cell is two drawn layers: widget_fg (the track, the icon and the level, drawn white and tinted black or white,
     by the night mode where the user follows it) and widget_arc above it (the level's coloured arc). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
